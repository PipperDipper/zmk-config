#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define MAC 0
#define WINDOWS 1
#define NAVIGATE 2
#define NUMBERS 4
#define SYMBOLS 3
#define MANAGE 5
#define NAV_MAC 7
#define NAV_WIN 8
#define MAC_WORD_DEL &kp LA(BSPC)  // Option (LA = Left Alt) + Backspace
#define WIN_WORD_DEL &kp LC(BSPC)  // Control (LC = Left Ctrl) + Backspace

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 3>; // FIXED: Updated from <NUM SYM>
            then-layer = <4>;
        };
    };

    behaviors {
        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <36 37 38 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };

        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        td_colon: td_colon {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COLON";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp COLON>;
        };

        sk_shift: sticky_key_shift {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_SHIFT";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1500>;
            quick-release;
            ignore-modifiers;
        };

        Bckspc_Del: Bckspc_Del {
            compatible = "zmk,behavior-mod-morph";
            label = "BCKSPC_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td_quote: td_quote {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_QUOTE";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp LS(SQT)>;
        };
    };

    macros {
        select_word_previous: select_word_previous {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LS(LEFT_ARROW))>;
            label = "SELECT_WORD_PREVIOUS";
        };

        select_word_next: select_word_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(RIGHT_ARROW))>;
            label = "SELECT_WORD_NEXT";
        };

        select_all_left: select_all_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(HOME)>;
            label = "SELECT_ALL_LEFT";
        };

        select_all_right: select_all_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(END)>;
            label = "SELECT_ALL_RIGHT";
        };

        select_line: select_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &select_all_right>;
            label = "SELECT_LINE";
        };

        insert_new_line: insert_new_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UP_ARROW &new_line>;
            label = "INSERT_NEW_LINE";
        };

        new_line: new_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp ENTER>;
            label = "NEW_LINE";
        };

        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "NEW_MACRO";
        };
    };

    combos {
        compatible = "zmk,combos";

        esc_combo {
            bindings = <&kp ESCAPE>;
            key-positions = <24 25>;
        };

        word_delete_mac {
            bindings = <&kp LA(BACKSPACE)>;
            key-positions = <12 13>;
            layers = <0>;
        };

        word_caps {
            bindings = <&caps_word>;
            key-positions = <16 19>;
        };

        word_delete_win {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <12 13>;
            layers = <1>;
        };

        mac_word_jump_left {
            bindings = <&kp LA(LEFT)>;
            key-positions = <19 20>;
            layers = <0>;
        };

        mac_word_jump_right {
            bindings = <&kp LA(RIGHT)>;
            key-positions = <21 22>;
            layers = <0>;
        };

        Forward_Delete {
            bindings = <&kp DELETE>;
            key-positions = <12 13 14>;
            layers = <0 1>;
        };

        win_word_jump_left {
            bindings = <&kp LC(LEFT)>;
            key-positions = <19 20>;
            layers = <1>;
        };

        win_word_jump_right {
            bindings = <&kp LC(RIGHT)>;
            key-positions = <21 22>;
            layers = <1>;
        };

        F2_rename {
            bindings = <&kp F2>;
            key-positions = <0 11>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac {
            display-name = "MAC";
            bindings = <
&kp TAB               &kp Q                &kp W            &kp F            &kp P              &kp B          &kp J  &kp L               &kp U            &kp Y             &td_colon             &kp ESCAPE
&Bckspc_Del           &HML LEFT_CONTROL A  &HML LEFT_ALT R  &HML LEFT_GUI S  &HML LEFT_SHIFT T  &kp G          &kp K  &HMR RIGHT_SHIFT N  &HMR LEFT_GUI E  &HMR RIGHT_ALT I  &HMR RIGHT_CONTROL O  &td_quote
&sk_shift LEFT_SHIFT  &ht LG(Z) Z          &ht LG(X) X      &ht LG(C) C      &ht LG(D) D        &ht LG(V) V    &kp M  &kp H               &kp COMMA        &kp DOT           &kp FSLH              &kp RET
                                                            &kp LGUI         &kp SPACE          &mo 2          &mo 3  &kp SPACE           &mo 6
            >;

            // FIXED: Changed &mo NAV to &mo NAVIGATE
        };

        windows {
            display-name = "WINDOWS";
            bindings = <
&kp TAB               &kp Q            &kp W            &kp F                &kp P              &kp B          &kp J  &kp L               &kp U                 &kp Y             &td_colon        &kp ESC
&Bckspc_Del           &HML LEFT_GUI A  &HML LEFT_ALT R  &HML LEFT_CONTROL S  &HML LEFT_SHIFT T  &kp G          &kp K  &HMR RIGHT_SHIFT N  &HMR RIGHT_CONTROL E  &HMR RIGHT_ALT I  &HMR LEFT_GUI O  &td_quote
&sk_shift LEFT_SHIFT  &ht LC(Z) Z      &ht LC(X) X      &ht LC(C) C          &ht LC(D) D        &ht LC(V) V    &kp M  &kp H               &kp COMMA             &kp DOT           &kp FSLH         &kp RET
                                                        &kp LCTRL            &kp SPACE          &mo 2          &mo 3  &kp SPACE           &mo 7
            >;

            // FIXED: Changed &mo NAV to &mo NAVIGATE
        };

        numbers {
            display-name = "NUMBERS";
            bindings = <
&trans  &trans  &trans  &trans    &trans          &trans    &trans     &kp N7  &kp N8   &kp N9  &kp MINUS     &trans
&trans  &trans  &trans  &trans    &sk LEFT_SHIFT  &trans    &trans     &kp N4  &kp N5   &kp N6  &kp PLUS      &trans
&trans  &trans  &trans  &trans    &trans          &trans    &kp SLASH  &kp N1  &kp N2   &kp N3  &kp ASTERISK  &trans
                        &kp LGUI  &kp SPACE       &trans    &trans     &kp N0  &kp DOT
            >;
        };

        symbols {
            display-name = "SYMBOLS";
            bindings = <
&trans       &kp LESS_THAN  &kp NON_US_BACKSLASH  &kp RG(RS(N4))  &kp LS(RG(N2))     &kp LEFT_BRACE          &kp RIGHT_BRACE        &kp MINUS       &kp PLUS       &kp SLASH     &kp GREATER_THAN  &kp DELETE
&trans       &kp EXCL       &kp AT                &kp HASH        &kp DLLR           &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp CARET       &kp AMPERSAND  &kp ASTERISK  &kp PERCENT       &kp GRAVE
&bootloader  &kp SEMI       &kp COLON             &kp SQT         &kp DOUBLE_QUOTES  &kp LBKT                &kp RIGHT_BRACKET      &kp UNDERSCORE  &kp EQUAL      &kp RBRC      &kp PIPE          &kp TILDE
                                                  &kp LGUI        &kp SPACE          &trans                  &trans                 &kp ENTER       &kp RALT
            >;
        };

        manage {
            display-name = "MANAGE";
            bindings = <
&trans       &trans        &trans        &trans        &trans        &bootloader     &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &tog 1  &tog 0  &trans  &trans  &trans  &trans
&bootloader  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &bootloader
                                         &trans        &trans        &trans          &trans  &trans  &trans
            >;

            // FIXED: Changed &tog WIN to &tog WINDOWS
        };

        layer_6 {
            display-name = "L6";
            bindings = <
&kp KP_MULTIPLY  &kp MINUS  &ht AMPS N7  &ht ASTRK N8  &ht LPAR N9   &kp PLUS     &kp HOME       &select_all_left  &select_word_previous  &select_word_next  &select_all_right  &kp END
&kp KP_DIVIDE    &kp BSPC   &ht DLLR N4  &ht PRCNT N5  &ht CARET N6  &kp RET      &kp LG(EQUAL)  &kp LEFT          &kp DOWN               &kp UP             &kp RIGHT          &new_line
&kp BSLH         &kp N0     &ht EXCL N1  &ht AT N2     &ht HASH N3   &kp DOT      &kp LG(MINUS)  &kp LS(LC(TAB))   &kp PG_DN              &kp PG_UP          &kp LC(TAB)        &insert_new_line
                                         &kp TILDE     &kp SPACE     &kp LSHFT    &kp SPACE      &kp LG(LS(LEFT))  &trans
            >;
        };

        NAV_MAC {
            display-name = "NAV_MAC";
            bindings = <
&kp ESCAPE  &kp LG(Z)         &kp LG(X)     &kp LG(C)     &kp LG(V)       &kp LG(D)               &kp PAGE_UP    &kp LG(LEFT)  &kp UP_ARROW  &kp LG(RIGHT)  &kp BACKSPACE  &kp DEL
&trans      &sk LEFT_CONTROL  &sk LEFT_ALT  &sk LEFT_GUI  &sk LEFT_SHIFT  &kp LG(LS(NUMBER_2))    &kp PAGE_DOWN  &kp LEFT      &kp DOWN      &kp RIGHT      &trans         &trans
&trans      &kp LG(A)         &trans        &trans        &trans          &kp LG(LS(NUMBER_4))    &trans         &kp LA(LEFT)  &trans        &kp LA(RIGHT)  &trans         &trans
                                            &trans        &trans          &trans                  &trans         &trans        &trans
            >;
        };

        NAV_WIN {
            display-name = "NAV_WIN";
            bindings = <
&kp ESCAPE  &kp LC(Z)     &kp LC(X)     &kp LC(C)         &kp LC(V)       &kp LC(D)    &kp PAGE_UP    &kp HOME      &kp UP_ARROW  &kp END        &kp BACKSPACE  &kp DEL
&trans      &sk LEFT_GUI  &sk LEFT_ALT  &sk LEFT_CONTROL  &sk LEFT_SHIFT  &trans       &kp PAGE_DOWN  &kp LEFT      &kp DOWN      &kp RIGHT      &trans         &trans
&trans      &kp LC(A)     &trans        &trans            &trans          &trans       &trans         &kp LC(LEFT)  &trans        &kp LC(RIGHT)  &trans         &trans
                                        &trans            &trans          &trans       &trans         &trans        &trans
            >;
        };

        symbols_backup {
            display-name = "SYMB";
            bindings = <
&kp TAB      &bootloader  &trans  &kp RG(RS(N4))  &kp LS(RG(N2))  &trans       &trans     &kp UNDERSCORE  &kp PLUS   &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp DELETE
&kp LCTRL    &kp EXCL     &kp AT  &kp HASH        &kp DLLR        &kp PRCNT    &kp CARET  &kp AMPS        &kp ASTRK  &kp LPAR        &kp RPAR         &kp GRAVE
&bootloader  &trans       &trans  &trans          &trans          &trans       &kp UNDER  &kp PLUS        &kp LBRC   &kp RBRC        &kp PIPE         &kp TILDE
                                  &kp LGUI        &kp SPACE       &trans       &trans     &kp ENTER       &kp RALT
            >;
        };

        layer_9 {
            display-name = "NUMB";
            bindings = <
&trans  &trans  &trans  &trans    &trans     &trans    &trans          &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DELETE
&trans  &kp N1  &kp N2  &kp N3    &kp N4     &kp N5    &kp N6          &kp N7     &kp N8     &kp N9            &kp N0             &trans
&trans  &trans  &trans  &trans    &trans     &trans    &kp LEFT_ARROW  &kp DOWN   &kp UP     &kp RIGHT         &trans             &bootloader
                        &kp LGUI  &kp SPACE  &trans    &trans          &kp ENTER  &kp RALT
            >;
        };
    };
};
